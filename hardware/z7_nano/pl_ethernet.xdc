# Schematic sheets 5/11: RTL8211F Bank35 DVDD_RG=3.3V.
set_property PACKAGE_PIN G14 [get_ports {eth_mdc}]
set_property PACKAGE_PIN J15 [get_ports {eth_mdio}]
set_property PACKAGE_PIN L19 [get_ports {eth_reset_n}]
set_property PACKAGE_PIN L14 [get_ports {eth_txc}]
set_property PACKAGE_PIN N16 [get_ports {eth_tx_ctl}]
set_property PACKAGE_PIN M14 [get_ports {eth_txd[0]}]
set_property PACKAGE_PIN L15 [get_ports {eth_txd[1]}]
set_property PACKAGE_PIN M15 [get_ports {eth_txd[2]}]
set_property PACKAGE_PIN N15 [get_ports {eth_txd[3]}]
set_property PACKAGE_PIN K17 [get_ports {eth_rxc}]
set_property PACKAGE_PIN K18 [get_ports {eth_rx_ctl}]
set_property PACKAGE_PIN J14 [get_ports {eth_rxd[0]}]
set_property PACKAGE_PIN K14 [get_ports {eth_rxd[1]}]
set_property PACKAGE_PIN M18 [get_ports {eth_rxd[2]}]
set_property PACKAGE_PIN M17 [get_ports {eth_rxd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {eth_mdc eth_mdio eth_reset_n eth_txc eth_tx_ctl eth_txd[*] eth_rxc eth_rx_ctl eth_rxd[*]}]
set_property PULLUP true [get_ports eth_mdio]
